{
  "name": "addhyan-academy",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 43123",
    "build": "node scripts/with-database-url.mjs generate && next build",
    "start": "node scripts/with-database-url.mjs migrate deploy && NODE_ENV=production node server.mjs",
    "postinstall": "node scripts/with-database-url.mjs generate",
    "db:migrate": "prisma migrate dev",
    "start:next": "next start --hostname 0.0.0.0 --port 43123",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/recommendations.test.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@prisma/client": "6.19.3",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^6.2.10",
    "lucide-react": "^1.40.0",
    "next": "16.3.4",
    "prisma": "6.19.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.20.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "eslint": "^9",
    "eslint-config-next": "16.3.4"
  }
}
