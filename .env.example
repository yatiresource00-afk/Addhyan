PORT=43123
HOST=0.0.0.0

# Local (path is relative to prisma/schema.prisma → project /data folder)
DATABASE_URL="file:../data/addhyan.db"

# Railway (attach a volume mounted at /data)
# DATABASE_URL="file:/data/addhyan.db"

AUTH_SECRET="replace-with-a-long-random-string-before-production"

# Code required on /admin/signup. Change this on Railway after the first staff account is created.
# ADMIN_SIGNUP_CODE="AddhyanDirectorSetup"

# Seed accounts (optional overrides)
# ADMIN_SEED_PASSWORD="Director@Addhyan1"
# MODERATOR_SEED_PASSWORD="Moderator@Addhyan1"
# STUDENT_SEED_PASSWORD="Student@Addhyan1"

# Email OTP via Resend (required in production)
# RESEND_API_KEY="re_..."
# EMAIL_FROM="Addhyan Academy <hello@addhyan.academy>"

# WhatsApp OTP via Twilio (required in production)
# TWILIO_ACCOUNT_SID="AC..."
# TWILIO_AUTH_TOKEN="..."
# TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"
# Approved WhatsApp authentication template. Variable {{1}} must be the code.
# TWILIO_WHATSAPP_CONTENT_SID="HX..."
