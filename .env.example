PORT=43123
HOST=0.0.0.0

# Local (path is relative to prisma/schema.prisma → project /data folder)
DATABASE_URL="file:../data/addhyan.db"

# Railway (attach a volume mounted at /data)
# DATABASE_URL="file:/data/addhyan.db"

AUTH_SECRET="replace-with-a-long-random-string-before-production"

# Seed accounts (optional overrides)
# ADMIN_SEED_PASSWORD="Director@Addhyan1"
# MODERATOR_SEED_PASSWORD="Moderator@Addhyan1"
# STUDENT_SEED_PASSWORD="Student@Addhyan1"

# Email OTP via Resend (optional — without this, OTP is shown in UI in dev mode)
# RESEND_API_KEY=
# EMAIL_FROM="Addhyan Academy <hello@addhyan.academy>"

# WhatsApp OTP via Twilio (optional — without this, OTP is shown in UI in dev mode)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"
